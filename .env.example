# Copy to .env and fill in at least ONE key. Never commit .env.
GROQ_API_KEY=
# GEMINI_API_KEY or GOOGLE_API_KEY both work
GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Which model does which job (provider:model). Comma = fallback order.
# "heuristic" = keyword baseline, no AI.
PROMO_TAG_MODEL=groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-120b
PROMO_JUDGE_MODEL=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b
